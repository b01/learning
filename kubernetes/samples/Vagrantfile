# -*- mode: ruby -*-
# vi:set ft=ruby sw=2 ts=2 sts=2:

BOX_IMG = "b01/ubuntu-server"
BOX_VER = "26.04"
# Time to wait for the VMs to boot up before timing out.
BOX_TIMEOUT = 300

# Unfortunately, these networks do not show up in the VirtualBox UI.
K8S_NETWORK = "k8s_int_net"

# dualstack or ipv6-only
NETWORK_MODE = ENV['NETWORK_MODE'] ? ENV['NETWORK_MODE'] : "ipv6-only"

# Define K8s nodes here.
NODES = [
  { cpus: 2, ram: 4096, ip6: "fd00:192:168:56::11", ip: "192.168.56.11", name: "control-plane-01" },
  { cpus: 1, ram: 2048, ip6: "fd00:192:168:56::21", ip: "192.168.56.21", name: "worker-01" },
  { cpus: 1, ram: 2048, ip6: "fd00:192:168:56::22", ip: "192.168.56.22", name: "worker-02" },
]

# Setup a network adapter on the guest machine using netplan.
def configure_adapter(node, interface, ip4, ip6, mode)
    # & 'C:\Program Files\Oracle\VirtualBox\VBoxManage.exe' list intnets

    # Copy netplan file into the guest machine.
    node.vm.provision "file",
        source: "./99-custom-#{mode}.yaml.tmpl",
        destination: "/tmp/99-custom.yaml.tmpl"

    # Add a netplan configuration for a NIC.
    node.vm.provision "shell", inline: <<-SHELL
        export VAGRANT_interface="#{interface}"
        export VAGRANT_ip4="#{ip4}"
        export VAGRANT_ip6="#{ip6}"
        envsubst < /tmp/99-custom.yaml.tmpl | sudo tee /etc/netplan/99-custom.yaml
        sudo chmod 0600 /etc/netplan/99-custom.yaml
        sudo netplan apply
    SHELL
end

# All Vagrant configuration is done below. The "2" in Vagrant.configure
# configures the configuration version (we support older styles for
# backwards compatibility).
Vagrant.configure("2") do |config|
    # Configuration options are commented below.
    # For a complete reference, please see https://docs.vagrantup.com.

    # Every Vagrant development environment requires a box. You can search for
    # boxes at https://portal.cloud.hashicorp.com/vagrant/discover
    config.vm.box = BOX_IMG
    config.vm.box_version = BOX_VER
    config.vm.boot_timeout = BOX_TIMEOUT

    # Disable automatic box update checking. If you disable this, then
    # boxes will only be checked for updates when the user runs
    # `vagrant box outdated`.
    config.vm.box_check_update = false

    # Linked clones are based on a master VM, which is generated by importing
    # the base box only once the first time it is required. For the linked
    # clones only differencing disk images are created where the parent disk
    # image belongs to the master VM.
    # see https://developer.hashicorp.com/vagrant/docs/providers/virtualbox/configuration#linked-clones
    config.vm.provider :virtualbox do |vb|
        vb.linked_clone = true
    end

    # Provision Nodes.
    NODES.each_with_index do |node, i|
        config.vm.define node[:name] do |node_config|
            node_config.vm.hostname = node[:name]
            # Provisioner specifics.
            node_config.vm.provider :virtualbox do |vb|
                # Name shown in the GUI
                vb.name = node[:name]
                vb.memory = node[:ram]
                vb.cpus = node[:cpus]
                #vm_info = `VBoxManage list dhcpserver` rescue ""

                #unless !vm_info.include?(K8S_NETWORK)
                #end

                # Add a second nic to join an intnet network.
                vb.customize [
                    "modifyvm", :id,
                    "--nic-type2", "82540EM",
                    "--nic2", "intnet",
                    "--intnet2", K8S_NETWORK,
                    "--cable-connected2", "on",
                ]
            end

            # Add a second adapter to operate over an private intnet
            # that will serve as the k8s network.
            configure_adapter(
                node_config,
                "enp0s8",
                node[:ip],
                node[:ip6],
                NETWORK_MODE
            )
        end
    end
end
